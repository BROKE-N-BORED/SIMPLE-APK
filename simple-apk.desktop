[Desktop Entry]
Type=Application
Name=Simple APK
Comment=Turn Android app source into an installable app file
Exec=python3 -c "import os,runpy,sys; p=sys.argv[1] if len(sys.argv)>1 else ''; d=os.path.dirname(os.path.abspath(p)) if p else os.getcwd(); sys.path.insert(0,d); runpy.run_module('apk_builder',run_name='__main__')" %k
Icon=simple-apk
Terminal=false
Categories=Utility;Development;
Keywords=apk;android;build;gradle;
StartupWMClass=simple-apk
